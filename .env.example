# 复制为 .env 后填写；变量名按实际服务商调整。
# 注意：本文件会提交到版本库，请勿填写真实密钥；真实值只放在 .env。

# 高德地图：路线 / POI / 坐标
AMAP_API_KEY=

# 彩云天气：实时天气 / 预警（可选；未配置时自动使用 Open-Meteo）
CAIYUN_API_KEY=

# Open-Meteo：免费天气，无需 key；设为 0 可关闭
OPEN_METEO_ENABLED=1

# 充电网络：充电桩 / 电价（商业供应商；未配置时使用高德 POI）
CHARGING_API_KEY=
CHARGING_API_BASE_URL=

# 救援与医疗：维修 / 医院 / 药店（商业供应商；未配置时使用高德 POI）
RESCUE_MEDICAL_API_KEY=
RESCUE_MEDICAL_API_BASE_URL=

# LLM（OpenAI 兼容接口）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# RAG（本地知识库；首次 ingest 会下载 embedding 模型）
RAG_ENABLED=1
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_TOP_K=5
RAG_CHUNK_CHARS=500
RAG_CHUNK_OVERLAP=80

# 会话持久化：memory（默认）或 sqlite（服务重启后仍可恢复待确认行程）
CHECKPOINTER_BACKEND=memory
CHECKPOINT_DB_PATH=data/checkpoints.sqlite

# 工具调用后端：direct（默认，进程内）或 mcp（持久 stdio MCP server）
TOOL_BACKEND=direct
MCP_MAX_CONCURRENCY=8

# 管理员接口（/admin/*）；留空表示不启用
ADMIN_API_KEY=
ADMIN_API_KEY_HEADER=X-Admin-Key

# 日志：text 或 json；json 适合 ELK/Loki 采集
LOG_LEVEL=INFO
LOG_FORMAT=text

# 请求体大小上限（字节）
MAX_REQUEST_BYTES=1000000

# API 安全（API_KEY / API_KEYS 都留空表示开发模式不鉴权）
# API_KEYS 支持逗号分隔的多用户 key；每个 key 的线程互相隔离
# 可写成 key-a:10 表示该 key 最近 24 小时最多创建 10 个行程
API_KEY=
API_KEYS=
API_KEY_HEADER=X-API-Key
RATE_LIMIT_PER_MINUTE=60
# 每个 owner 最近 24 小时可创建的行程数；0 表示不限制
TENANT_MAX_THREADS_PER_DAY=0
# 审计事件保留天数；0 表示永久保留
AUDIT_RETENTION_DAYS=30

# 外部工具 HTTP 超时/重试（5xx、429、网络错误会重试）
TOOL_TIMEOUT_SECONDS=10
TOOL_MAX_RETRIES=2
TOOL_RETRY_BACKOFF_SECONDS=0.5

# 费用估算（不含住宿/餐饮/门票）
FUEL_PRICE_CNY_PER_L=7.5
FUEL_CONSUMPTION_L_PER_100KM=8.0
ELECTRICITY_PRICE_CNY_PER_KWH=1.2
EV_CONSUMPTION_KWH_PER_100KM=16.0
PHEV_FUEL_SHARE=0.5
# 逗号分隔，例如 https://app.example.com
CORS_ORIGINS=
